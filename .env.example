NEXT_PUBLIC_SITE_URL=https://bayblaze.net
NEXT_PUBLIC_MEDUSA_BACKEND_URL=https://api.bayblaze.net
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_your_publishable_key_here
# Optional public storefront-wide item price adjustment, in cents.
# Set to 500 to show/cart/checkout every item at $5 off its catalog price.
NEXT_PUBLIC_BAYBLAZE_PRICE_ADJUSTMENT_CENTS=0
# Server-only. Product/shop/home catalog reads go through bayblaze-api.
BAYBLAZE_API_URL=https://api.bayblaze.net
BAYBLAZE_API_SERVICE_TOKEN=
# Optional. If omitted, the storefront asks Medusa for the first region.
NEXT_PUBLIC_MEDUSA_REGION_ID=
# Server-only. Reuse the Resend key/from address from the Bayblaze landing page.
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL="BAYBLAZE <noreply@bayblaze.net>"
EMAIL_VERIFICATION_SECRET=replace_with_a_long_random_value

# Optional. Enables AgeChecker.Net checkout verification when configured.
NEXT_PUBLIC_AGECHECKER_KEY=
# Optional server-side override for AgeChecker.Net /v1/validate.
AGECHECKER_API_KEY=
# Server-only secret used to sign BayBlaze age verification checkout tokens.
# Falls back to EMAIL_VERIFICATION_SECRET if omitted.
AGE_VERIFICATION_TOKEN_SECRET=
AGE_VERIFICATION_TOKEN_TTL_MINUTES=60

# Server-only secret used to sign BayBlaze routing evaluation checkout tokens.
# Falls back to AGE_VERIFICATION_TOKEN_SECRET or EMAIL_VERIFICATION_SECRET if omitted.
ROUTING_EVALUATION_TOKEN_SECRET=
ROUTING_EVALUATION_TOKEN_TTL_MINUTES=30
