NEXT_PUBLIC_SITE_URL=https://bayblaze.net
NEXT_PUBLIC_MEDUSA_BACKEND_URL=https://api.bayblaze.net
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_your_publishable_key_here
# Optional. If omitted, the storefront asks Medusa for the first region.
NEXT_PUBLIC_MEDUSA_REGION_ID=

# Server-only. Reuse the Resend key/from address from the Bayblaze landing page.
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL="BAYBLAZE <noreply@bayblaze.net>"
EMAIL_VERIFICATION_SECRET=replace_with_a_long_random_value
